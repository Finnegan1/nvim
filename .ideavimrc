let g:WhichKeyDesc_leader = "<leader> Leader key"

" Diagnostics group
let g:WhichKeyDesc_diagnostics = "<leader>d +Diagnostics"
let g:WhichKeyDesc_diagnostics_prev = "<leader>dp Previous diagnostic"

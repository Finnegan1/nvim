let g:WhichKeyDesc_diagnostics_show = "<leader>ds Show diagnostic"
let g:WhichKeyDesc_diagnostics_workspace = "<leader>dw Workspace diagnostics"
let g:WhichKeyDesc_diagnostics_buffer = "<leader>dd Buffer diagnostics"

" LSP group
let g:WhichKeyDesc_lsp = "<leader>l +LSP"
let g:WhichKeyDesc_lsp_rename = "<leader>lr Rename"
let g:WhichKeyDesc_lsp_format = "<leader>lf Format"
let g:WhichKeyDesc_lsp_optimize = "<leader>lo Optimize imports"
let g:WhichKeyDesc_lsp_generate = "<leader>lg Generate"
let g:WhichKeyDesc_lsp_hierarchy = "<leader>lc Call hierarchy"
let g:WhichKeyDesc_lsp_test = "<leader>lt Go to test"

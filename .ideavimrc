let g:WhichKeyDesc_run_debug = "<leader>rd Debug"
let g:WhichKeyDesc_run_stop = "<leader>rs Stop"
let g:WhichKeyDesc_run_choose = "<leader>rc Choose config"
let g:WhichKeyDesc_run_edit = "<leader>re Edit configs"


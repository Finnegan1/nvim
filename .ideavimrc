let g:WhichKeyDesc_harpoon_search = "<leader>hs Search bookmarks"
let g:WhichKeyDesc_harpoon_prev = "<leader>hh Previous bookmark"
let g:WhichKeyDesc_harpoon_next = "<leader>hl Next bookmark"

" Find/Fuzzy group

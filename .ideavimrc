let g:WhichKeyDesc_tab = "<leader>t +Tab"
let g:WhichKeyDesc_tab_next = "<leader>tn Next tab"
let g:WhichKeyDesc_tab_prev = "<leader>tp Previous tab"
let g:WhichKeyDesc_tab_close = "<leader>tc Close tab"
let g:WhichKeyDesc_tab_only = "<leader>to Close other tabs"

" ============================================================================
" END OF CONFIGURATION
" ============================================================================
" This .ideavimrc closely mirrors the Neovim configuration
" Some Neovim-specific plugins (Molten, CodeCompanion) have limited equivalents
" but all core functionality and keybindings are preserved
" ============================================================================

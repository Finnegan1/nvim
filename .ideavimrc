let g:WhichKeyDesc_jupyter_run_cell = "<leader>jc Run cell"
let g:WhichKeyDesc_jupyter_run_all = "<leader>jA Run all"
let g:WhichKeyDesc_jupyter_run_above = "<leader>ja Run above"
let g:WhichKeyDesc_jupyter_run_line = "<leader>jl Run line"

" Git group
let g:WhichKeyDesc_git = "<leader>g +Git"
let g:WhichKeyDesc_git_blame = "<leader>gb Git blame"
let g:WhichKeyDesc_git_diff = "<leader>gd Git diff"
let g:WhichKeyDesc_git_status = "<leader>gs Git status"
let g:WhichKeyDesc_git_commit = "<leader>gc Git commit"
let g:WhichKeyDesc_git_push = "<leader>gp Git push"
let g:WhichKeyDesc_git_update = "<leader>gu Git update"
let g:WhichKeyDesc_git_log = "<leader>gl Git log"
let g:WhichKeyDesc_git_history = "<leader>gh Git history"

" Run/Debug group
